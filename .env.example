# Скопировать в .env перед `make up`.

HTTP_ADDR=:8080

# Порядковый номер инстанса. Определяет шард счётчиков (architecture.md §7).
# Ординал, а не hash(instance_id): хеш без нужды схлопнул бы два инстанса в один шард.
INSTANCE_ORDINAL=0
COUNTER_SHARDS=4

POSTGRES_DSN=postgres://vote:vote@postgres:5432/vote?sslmode=disable
POSTGRES_MAX_CONNS=20

REDIS_ADDR=redis:6379
REDIS_POOL_SIZE=200

# Единственный синхронный round-trip на горячем пути (architecture.md §6).
# Таймаут ограничивает урон от одного запроса, breaker — системный.
DEDUP_TIMEOUT=50ms
BREAKER_ERROR_THRESHOLD=20
BREAKER_WINDOW=1s
BREAKER_PROBE_INTERVAL=3s

# Батчинг счётчиков (architecture.md §5.6). Flush по таймеру ИЛИ по порогу — что раньше.
FLUSH_INTERVAL=150ms
FLUSH_THRESHOLD=10000

# Читающее зеркало батчера и снапшот в Postgres (architecture.md §5.2, §5.7).
SNAPSHOT_INTERVAL=1s
PERSIST_INTERVAL=5s

# Применяется только к приёму голоса. Клиенту ends_at отдаётся без него (architecture.md §5.5).
VOTE_GRACE_PERIOD=3s

# Секрет подписи токена. В проде — из секрет-хранилища (architecture.md §5.1).
TOKEN_HMAC_SECRET=dev-secret-change-me
TOKEN_TTL=24h

ADMIN_BEARER_TOKEN=dev-admin-token

# Сколько ждать завершения текущих запросов и финального flush батчера
# (architecture.md §5.4).
SHUTDOWN_TIMEOUT=10s

# Журналирование (internal/httpapi/logstats.go).
# На горячем пути пишется одна строка из N: при 250K RPS строка на запрос была бы
# второй нагрузочной системой поверх первой. Полную картину даёт агрегат.
LOG_LEVEL=info
ACCESS_LOG_SAMPLE_N=1000
LOG_SUMMARY_INTERVAL=5s
